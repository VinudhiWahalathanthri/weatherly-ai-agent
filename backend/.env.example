# Copy this file to backend/.env and fill in your own key.
# Get a free Gemini API key at https://aistudio.google.com/apikey
# If this is unset, the agent automatically falls back to a local Ollama
# model, then to a rule-based extractor — no key is required to run it.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Used for emailing reports. SMTP_PASS should be a Gmail "app password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
